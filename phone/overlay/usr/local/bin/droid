#!/usr/bin/env python3
"""droid - drive Android apps from the chroot (screencap / uiautomator / input via ashell).

Apps open on a background screen of the assistant's own, which the owner doesn't see: they keep
using the phone meanwhile. Every command below goes to that screen while it is open.

Observe -> act -> observe again:
  droid ui [--all]            list on-screen controls: number, text, centre in device px
  droid shot [--grid] [--scale S] [-o FILE]
                              screenshot PNG (default /tmp/droid/shot.png at 0.5x)
  droid tap-id N              tap control N from the last `droid ui`
  droid tap-text TEXT         fresh dump, tap the control whose text/desc matches
  droid tap X Y | longpress X Y [MS] | swipe X1 Y1 X2 Y2 [MS]
  droid text STRING [--id N | --at X Y]
                              type into a field: the one just tapped, or control N / the one at X Y
                              (any language; on the background screen no keyboard ever shows)
  droid key NAME              back enter del tab esc up down left right ... (home/recent: owner's screen only)
  droid app NAME [--front]    open an app by its name (微信) or package: on the background screen,
                              or with --front on the owner's
  droid apps [WORD]           installed apps: name, package (WORD searches both)
  droid top | wake
  droid wait-text TEXT [--timeout SEC]
The background screen:
  droid bg                    is it open, and what is on it
  droid show                  move its app onto the owner's screen (when they want to see or take over)
  droid bg stop               close it; commands go to the owner's screen again
Coordinates are always device pixels unless stated otherwise.
"""
import argparse
import base64
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import xml.etree.ElementTree as ET

STATE = "/tmp/droid"
UI_JSON = f"{STATE}/ui.json"
LAST_TAP = f"{STATE}/last_tap.json"
# /data is bind-mounted into the chroot at the same path, so the dump is readable directly.
UI_XML = "/data/local/tmp/droid_ui.xml"
ADB_IME = "com.android.adbkeyboard/.AdbIME"

KEYS = {
    "back": "BACK", "home": "HOME", "enter": "ENTER", "recent": "APP_SWITCH",
    "recents": "APP_SWITCH", "power": "POWER", "menu": "MENU", "del": "DEL",
    "backspace": "DEL", "tab": "TAB", "esc": "ESCAPE", "escape": "ESCAPE",
    "up": "DPAD_UP", "down": "DPAD_DOWN", "left": "DPAD_LEFT", "right": "DPAD_RIGHT",
    "volup": "VOLUME_UP", "voldown": "VOLUME_DOWN", "wake": "WAKEUP", "sleep": "SLEEP",
    "search": "SEARCH", "space": "SPACE",
}
# Keys that act on the whole phone, not on one screen.
GLOBAL_KEYS = {"POWER", "VOLUME_UP", "VOLUME_DOWN", "WAKEUP", "SLEEP"}
# Keys only the owner's screen has: the background screen has no home screen or recents.
OWNER_ONLY_KEYS = {"HOME", "APP_SWITCH"}


def ash(*args, check=True, data=None):
    r = subprocess.run(["ashell", *map(str, args)], capture_output=True, input=data)
    if check and r.returncode != 0:
        err = (r.stderr or r.stdout).decode(errors="replace").strip()
        sys.exit(f"droid: `{' '.join(map(str, args))}` failed: {err}")
    return r


def out(*args):
    return ash(*args).stdout.decode(errors="replace")


# ---------- the app's floating windows ----------
# DroidAgent shows a floating face while it works in other apps. It must not end up in a screenshot
# or catch a tap meant for the app underneath, so it is hidden for those moments. The app writes
# where its windows are; /data is the same directory inside the chroot.
APP_PKG = "com.droidagent.app"
OVERLAY_STATE = f"/data/user_de/0/{APP_PKG}/overlay.state"
OVERLAY_HIDE = f"{APP_PKG}.OVERLAY_HIDE"


def overlay_windows():
    """[(x, y, w, h)] of the floating windows on screen now, in device px."""
    try:
        with open(OVERLAY_STATE) as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    wins = []
    for line in lines:
        p = line.split()
        if len(p) == 6 and p[0] in ("bubble", "panel") and p[1] == "1":
            try:
                wins.append(tuple(int(v) for v in p[2:]))
            except ValueError:
                pass
    return wins


def overlay_covers(x, y, margin=12):
    return any(wx - margin <= x <= wx + w + margin and wy - margin <= y <= wy + h + margin
               for wx, wy, w, h in overlay_windows())


class OverlayHidden:
    """with OverlayHidden(needed): ...  hides the floating windows for what runs inside.
    `am broadcast` returns once the app has handled it; a short pause lets the next frame land."""

    def __init__(self, needed):
        self.needed = needed

    def __enter__(self):
        if self.needed:
            ash("am", "broadcast", "-a", OVERLAY_HIDE, "-p", APP_PKG, "--ez", "hide", "true",
                "--el", "ms", "8000", check=False)
            time.sleep(0.15)
        return self

    def __exit__(self, *exc):
        if self.needed:
            # Not waited for: the app brings them back by itself after `ms` anyway.
            subprocess.Popen(["ashell", "am", "broadcast", "-a", OVERLAY_HIDE, "-p", APP_PKG,
                              "--ez", "hide", "false"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return False


# ---------- the background screen ----------
# A virtual display held by BgScreen in the app's APK, which runs as root through app_process and
# answers on an abstract socket, to root only. Apps start on it with `am start --display`, input
# goes there with `input -d`, and screenshots, controls and text come from BgScreen itself.
BG_SOCK = "\0droidagent-bgscreen"
BG_DIR = "/data/local/tmp/droid-bg"
BG_CLASS = "com.droidagent.app.BgScreen"


def bg_call(line, check=True, timeout=30):
    """One command to BgScreen. None when it isn't running."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(BG_SOCK)
    except OSError:
        s.close()
        return None
    try:
        s.sendall((line + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except OSError as e:
        buf = f"err {e}".encode()
    finally:
        s.close()
    r = buf.decode(errors="replace").strip()
    if r.startswith("err"):
        if check:
            sys.exit(f"droid: background screen: {r[4:]}")
        return r
    return r[3:] if r.startswith("ok ") else ("" if r == "ok" else r)


_bg = "unknown"


def bg():
    """What is on the background screen, or None when it isn't open. Asked once per command."""
    global _bg
    if _bg == "unknown":
        r = bg_call("info", check=False)
        try:
            _bg = json.loads(r) if r and not r.startswith("err") else None
        except ValueError:
            _bg = None
    return _bg


def screen_metrics():
    def pick(text, kind):
        found = {}
        for line in text.splitlines():
            m = re.match(r"\s*(Physical|Override) \w+:\s*(\S+)", line)
            if m:
                found[m.group(1)] = m.group(2)
        v = found.get("Override") or found.get("Physical")
        if not v:
            sys.exit(f"droid: can't read the screen {kind}")
        return v
    w, h = pick(out("wm", "size"), "size").split("x")
    return int(w), int(h), int(pick(out("wm", "density"), "density"))


def bg_start():
    """Open the background screen if it isn't. Returns (info, None) or (None, why not)."""
    global _bg
    if bg():
        return _bg, None
    paths = [l.split(":", 1)[1] for l in out("pm", "path", APP_PKG).split() if l.startswith("package:")]
    if not paths:
        return None, "DroidAgent's APK was not found"
    w, h, dpi = screen_metrics()
    os.makedirs(BG_DIR, exist_ok=True)
    os.chmod(BG_DIR, 0o777)  # BgScreen may have to run as the shell user on some phones
    log = f"{BG_DIR}/helper.log"
    subprocess.Popen(
        ["ashell", "sh", "-c", f'CLASSPATH="$0" exec app_process /system/bin {BG_CLASS} serve {w} {h} {dpi} > {log} 2>&1',
         paths[0]],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(60):
        time.sleep(0.25)
        _bg = "unknown"
        if bg():
            return _bg, None
        try:
            with open(log) as f:
                text = f.read()
        except OSError:
            text = ""
        if "Exception" in text or "Error" in text:
            break
    try:
        with open(log) as f:
            lines = [l.strip() for l in f if l.strip()]
    except OSError:
        lines = []
    why = next((l for l in lines if "Exception" in l or "Error" in l), lines[-1] if lines else "it did not start")
    return None, why[:300]


def bg_display():
    return bg()["display"]


def bg_note():
    """Said whenever the background screen has nothing on it, so nobody acts on a blank."""
    info = bg()
    if not info or info.get("tasks"):
        return
    if info.get("takenOver"):
        print(f"note: the owner moved {info['takenOver']} to their own screen; nothing is open on the background "
              "screen. Don't work on their screen without asking: `droid app PKG` opens an app here again.")
    else:
        print("note: nothing is open on the background screen (the app closed). `droid app PKG` opens one.")


# ---------- observe ----------

def dump_ui(show_all=False):
    os.makedirs(STATE, exist_ok=True)
    if bg():
        xml_path = f"{BG_DIR}/ui.xml"
        bg_call(f"ui {xml_path}")
    else:
        xml_path = UI_XML
        err = ""
        for _ in range(4):
            if os.path.exists(UI_XML):
                os.remove(UI_XML)
            r = ash("uiautomator", "dump", UI_XML, check=False)
            if os.path.exists(UI_XML) and os.path.getsize(UI_XML) > 0:
                break
            err = (r.stderr + r.stdout).decode(errors="replace").strip()
            time.sleep(0.8)  # "could not get idle state" while animating
        else:
            sys.exit(f"droid: uiautomator dump failed: {err}")

    nodes = []
    pkg = None
    for n in ET.parse(xml_path).getroot().iter("node"):
        b = [int(v) for v in re.findall(r"-?\d+", n.get("bounds", ""))]
        if len(b) != 4 or b[2] <= b[0] or b[3] <= b[1]:
            continue
        pkg = pkg or n.get("package")
        text, desc = n.get("text", ""), n.get("content-desc", "")
        cls = n.get("class", "").rsplit(".", 1)[-1]
        flags = [f for f, k in (("click", "clickable"), ("long", "long-clickable"),
                                ("scroll", "scrollable"), ("checked", "checked"),
                                ("focused", "focused")) if n.get(k) == "true"]
        if cls == "EditText":
            flags.append("edit")
        if n.get("enabled") == "false":
            flags.append("disabled")
        if not show_all and not (text or desc or set(flags) & {"click", "long", "scroll", "edit"}):
            continue
        nodes.append({
            "i": len(nodes), "cls": cls, "text": text, "desc": desc,
            "id": n.get("resource-id", "").rsplit("/", 1)[-1],
            "x": (b[0] + b[2]) // 2, "y": (b[1] + b[3]) // 2, "bounds": b, "flags": flags,
        })
    with open(UI_JSON, "w") as f:
        json.dump({"pkg": pkg, "nodes": nodes, "screen": "background" if bg() else "owner"}, f, ensure_ascii=False)
    return pkg, nodes


def fmt(d):
    s = f"[{d['i']}] {d['cls']}"
    if d["text"]:
        s += f' "{d["text"]}"'
    if d["desc"]:
        s += f' desc="{d["desc"]}"'
    if d["id"]:
        s += f" id={d['id']}"
    s += f" @({d['x']},{d['y']})"
    if d["flags"]:
        s += " [" + ",".join(d["flags"]) + "]"
    return s


def cmd_ui(a):
    pkg, nodes = dump_ui(a.all)
    where = "background screen" if bg() else "owner's screen"
    print(f"# {where}  app={pkg}  {len(nodes)} controls  (device px; tap with `droid tap-id N`)")
    if bg():
        print("# no keyboard ever shows here, that is normal: type with `droid text \"...\" --id N` (N = an [edit] control)")
    for d in nodes:
        print(fmt(d))
    if bg():
        bg_note()


def cmd_shot(a):
    from PIL import Image, ImageDraw

    os.makedirs(STATE, exist_ok=True)
    full = f"{STATE}/shot_full.png"
    if bg():
        src = f"{BG_DIR}/shot.png"
        bg_call(f"shot {src}")
        shutil.copyfile(src, full)
    else:
        with OverlayHidden(bool(overlay_windows())):
            png = ash("screencap", "-p").stdout
        with open(full, "wb") as f:
            f.write(png)
    im = Image.open(full).convert("RGB")
    w, h = im.size
    dest = a.output or f"{STATE}/shot.png"
    if a.scale != 1:
        im = im.resize((round(w * a.scale), round(h * a.scale)), Image.LANCZOS)
    if a.grid:
        d = ImageDraw.Draw(im)
        step = 200
        for dev in range(step, max(w, h), step):
            p = dev * a.scale
            if dev < w:
                d.line([(p, 0), (p, im.height)], fill=(255, 0, 64), width=1)
                d.text((p + 3, 3), str(dev), fill=(255, 0, 64))
            if dev < h:
                d.line([(0, p), (im.width, p)], fill=(255, 0, 64), width=1)
                d.text((3, p + 3), str(dev), fill=(255, 0, 64))
    im.save(dest)
    print(f"{dest}  {im.width}x{im.height}  device {w}x{h}  "
          f"(device coord = image coord / {a.scale}{'; grid labels are device px' if a.grid else ''})"
          + ("  [background screen]" if bg() else ""))
    if bg():
        bg_note()


# ---------- act ----------

def tap(x, y):
    if bg():
        ash("input", "-d", bg_display(), "tap", x, y)
    else:
        with OverlayHidden(overlay_covers(x, y)):
            ash("input", "tap", x, y)
    # `droid text` finds the field here when nothing has focus.
    os.makedirs(STATE, exist_ok=True)
    with open(LAST_TAP, "w") as f:
        json.dump({"screen": "background" if bg() else "owner", "x": x, "y": y}, f)
    print(f"tapped ({x},{y})")


def last_tap():
    try:
        with open(LAST_TAP) as f:
            j = json.load(f)
        if j.get("screen") == ("background" if bg() else "owner"):
            return int(j["x"]), int(j["y"])
    except (OSError, ValueError, KeyError):
        pass
    return -1, -1


def press(x1, y1, x2, y2, ms):
    """A swipe, or a long press when it starts and ends in one place."""
    if bg():
        ash("input", "-d", bg_display(), "swipe", x1, y1, x2, y2, ms)
        return
    with OverlayHidden(overlay_covers(x1, y1) or overlay_covers(x2, y2)):
        ash("input", "swipe", x1, y1, x2, y2, ms)


def load_nodes():
    try:
        with open(UI_JSON) as f:
            j = json.load(f)
    except FileNotFoundError:
        sys.exit("droid: no UI dump yet, run `droid ui` first")
    if j.get("screen", "owner") != ("background" if bg() else "owner"):
        sys.exit("droid: the last `droid ui` was of the other screen; run `droid ui` again")
    return j["nodes"]


def find_text(nodes, text):
    exact = [d for d in nodes if text in (d["text"], d["desc"])]
    if exact:
        return exact
    low = text.lower()
    return [d for d in nodes if low in d["text"].lower() or low in d["desc"].lower()]


def cmd_tap_id(a):
    nodes = load_nodes()
    if not 0 <= a.n < len(nodes):
        sys.exit(f"droid: no control [{a.n}] in last dump ({len(nodes)} controls)")
    d = nodes[a.n]
    print(fmt(d))
    tap(d["x"], d["y"])


def cmd_tap_text(a):
    _, nodes = dump_ui(True)
    hits = find_text(nodes, a.text)
    if not hits:
        sys.exit(f'droid: nothing on screen matches "{a.text}"')
    if len(hits) > 1:
        print(f"note: {len(hits)} matches, tapping the first:", *map(fmt, hits[:5]), sep="\n  ")
    print(fmt(hits[0]))
    tap(hits[0]["x"], hits[0]["y"])


def type_once(display, s):
    """Text into a field through BgScreen's `type`, without the background screen running."""
    paths = [l.split(":", 1)[1] for l in out("pm", "path", APP_PKG).split() if l.startswith("package:")]
    if not paths:
        return "err DroidAgent's APK was not found"
    x, y = last_tap()
    r = ash("sh", "-c", f'CLASSPATH="$0" exec app_process /system/bin {BG_CLASS} type {display} {x} {y} "$1"',
            paths[0], base64.b64encode(s.encode()).decode(), check=False)
    lines = [l for l in r.stdout.decode(errors="replace").splitlines() if l.startswith(("ok", "err"))]
    return lines[-1] if lines else "err " + (r.stderr or r.stdout).decode(errors="replace").strip()[-300:]


def cmd_text(a):
    """Into the field without a keyboard: BgScreen sets it through accessibility (or pastes, or
    presses keys aimed at that screen), checks it arrived, and says how."""
    s = a.string
    if a.id is not None or a.at:
        # Aimed at a field: tap it (that gives it focus where the app allows), then type into it.
        if a.id is not None:
            nodes = load_nodes()
            if not 0 <= a.id < len(nodes):
                sys.exit(f"droid: no control [{a.id}] in last dump ({len(nodes)} controls)")
            tap(nodes[a.id]["x"], nodes[a.id]["y"])
        else:
            tap(*a.at)
        time.sleep(0.4)
    if bg():
        x, y = last_tap()
        r = bg_call(f"type {x} {y} " + base64.b64encode(s.encode()).decode(), check=False)
        if r is not None and not r.startswith("err"):
            r = "ok " + r  # bg_call leaves the "ok" off
    elif s.isascii():
        ash("input", "text", s.replace(" ", "%s"))
        r = "ok keys"
    else:
        r = type_once(0, s)
        if not r.startswith("ok") and "package:" in ash("pm", "path", "com.android.adbkeyboard", check=False).stdout.decode():
            prev = out("settings", "get", "secure", "default_input_method").strip()
            ash("ime", "enable", ADB_IME, check=False)
            ash("ime", "set", ADB_IME)
            time.sleep(0.4)
            ash("am", "broadcast", "-a", "ADB_INPUT_B64", "--es", "msg", base64.b64encode(s.encode()).decode())
            time.sleep(0.3)
            if prev and prev != ADB_IME and prev != "null":
                ash("ime", "set", prev, check=False)
            r = "ok ADBKeyboard"
    if not r or not r.startswith("ok"):
        sys.exit(f"droid: could not type that: {r[4:] if r and r.startswith('err ') else r}")
    print(f"typed {len(s)} chars ({r[3:] or 'ok'})")


def cmd_key(a):
    k = KEYS.get(a.name.lower(), a.name.upper())
    code = k if k.isdigit() or k.startswith("KEYCODE_") else "KEYCODE_" + k
    if bg() and k in OWNER_ONLY_KEYS:
        sys.exit(f"droid: the background screen has no {a.name} screen. Open another app with `droid app PKG`, "
                 "or close the background screen with `droid bg stop`.")
    if bg() and k not in GLOBAL_KEYS:
        ash("input", "-d", bg_display(), "keyevent", code)
    else:
        ash("input", "keyevent", code)
    print(f"key {k}")


def launcher_component(pkg):
    res = out("cmd", "package", "resolve-activity", "--brief", "-c",
              "android.intent.category.LAUNCHER", pkg).strip().splitlines()
    comp = res[-1].strip() if res else ""
    return comp if "/" in comp else None


APPS_JSON = f"{STATE}/apps.json"


def installed_apps(fresh=False):
    """[{package, name, activity, system, installed}] for every app with a launcher icon, by the name
    the owner sees, from BgScreen. Kept a minute; a name that isn't found asks again (a new install)."""
    if not fresh:
        try:
            if time.time() - os.path.getmtime(APPS_JSON) < 60:
                with open(APPS_JSON) as f:
                    return json.load(f)
        except (OSError, ValueError):
            pass
    apps = None
    paths = [l.split(":", 1)[1] for l in out("pm", "path", APP_PKG).split() if l.startswith("package:")]
    if paths:
        r = ash("sh", "-c", f'CLASSPATH="$0" exec app_process /system/bin {BG_CLASS} apps', paths[0], check=False)
        line = next((l for l in r.stdout.decode(errors="replace").splitlines() if l.startswith("[")), None)
        try:
            apps = json.loads(line) if line else None
        except ValueError:
            apps = None
    if not apps:
        apps = [{"package": l.split(":", 1)[1], "name": l.split(":", 1)[1], "system": False}
                for l in out("pm", "list", "packages", "-3").split() if ":" in l]
    os.makedirs(STATE, exist_ok=True)
    with open(APPS_JSON, "w") as f:
        json.dump(apps, f, ensure_ascii=False)
    return apps


def match_apps(apps, word):
    """Exact name or package first, then names and packages containing the word."""
    w = word.casefold()
    exact = [x for x in apps if w in (x["name"].casefold(), x["package"].casefold())]
    return exact or [x for x in apps if w in x["name"].casefold() or w in x["package"].casefold()]


def resolve_app(word):
    """A package for what the agent called the app: its package, or its name as the owner sees it."""
    for fresh in (False, True):
        hits = match_apps(installed_apps(fresh), word)
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            names = "\n  ".join(f"{x['name']}  {x['package']}" for x in hits[:12])
            sys.exit(f'droid: "{word}" could be any of these; say which with its package:\n  {names}')
    if "package:" in ash("pm", "path", word, check=False).stdout.decode(errors="replace"):
        return {"package": word, "name": word}
    sys.exit(f'droid: no app called "{word}" is installed. `droid apps` lists them all, `droid apps WORD` searches.')


def cmd_app(a):
    global _bg
    found = resolve_app(a.pkg)
    a.pkg = found["package"]
    comp = found.get("activity") or launcher_component(a.pkg)
    if not a.front:
        info, why = bg_start()
        if info:
            if comp is None:
                sys.exit(f"droid: {a.pkg} has nothing to open (no launcher activity); is it installed? `droid apps`")
            owner_top = bg_call("top 0", check=False)
            if owner_top == a.pkg:
                sys.exit(f"droid: the owner is using {a.pkg} on their screen right now, and opening it on the background "
                         "screen would take it away from them. Ask them first; to work on their screen instead: "
                         f"`droid app {a.pkg} --front`.")
            ash("am", "start", "--display", info["display"], "-n", comp)
            print(f"started {comp} on the background screen (the owner keeps their screen; "
                  "`droid show` puts it in front of them)")
            return
        print(f"note: no background screen ({why}); opening on the owner's screen")
    elif bg():
        # --front: the commands that follow go to the owner's screen.
        bg_call("quit", check=False)
        _bg = None
        print("note: closed the background screen")
    if comp:
        ash("am", "start", "-n", comp)
        print(f"started {comp}")
    else:
        ash("monkey", "-p", a.pkg, "-c", "android.intent.category.LAUNCHER", "1")
        print(f"started {a.pkg} (via monkey)")


def cmd_apps(a):
    apps = installed_apps(fresh=True)
    if a.filter:
        apps = match_apps(apps, a.filter)
    apps = sorted(apps, key=lambda x: (x.get("system", False), x["name"].casefold()))
    for x in apps:
        print(f"{x['name']}\t{x['package']}" + ("\t(system)" if x.get("system") else ""))
    if not apps:
        print(f'no app matches "{a.filter}"' if a.filter else "no apps found")


def cmd_top(a):
    if bg():
        info = bg()
        print(f"background screen: {info.get('activity') or 'nothing open'}")
        print(f"owner's screen: {bg_call('top 0', check=False)}")
        return
    for l in out("dumpsys", "window").splitlines():
        if "mCurrentFocus" in l or "mFocusedApp" in l:
            print(l.strip())


def cmd_wake(a):
    ash("input", "keyevent", "KEYCODE_WAKEUP")
    ash("wm", "dismiss-keyguard", check=False)
    print("awake (keyguard dismissed if not secure)")


def cmd_wait_text(a):
    end = time.time() + a.timeout
    while time.time() < end:
        _, nodes = dump_ui(True)
        hits = find_text(nodes, a.text)
        if hits:
            print(fmt(hits[0]))
            return
        time.sleep(1)
    sys.exit(f'droid: "{a.text}" did not appear within {a.timeout}s')


def cmd_bg(a):
    info = bg()
    if a.action == "stop":
        if info:
            bg_call("quit", check=False)
            print("closed the background screen; commands go to the owner's screen again")
        else:
            print("the background screen was not open")
        return
    if not info:
        print("background screen: not open (`droid app PKG` opens it)")
        return
    print(f"background screen: display {info['display']}, {info['w']}x{info['h']}, "
          f"app: {info.get('activity') or 'nothing open'}")
    bg_note()


def cmd_show(a):
    info = bg()
    if not info:
        sys.exit("droid: the background screen is not open; the app is already on the owner's screen")
    pkg = bg_call("takeover")
    print(f"moved {pkg} to the owner's screen. Commands still go to the background screen, now empty; "
          "to keep working on the owner's screen, ask them first, then `droid bg stop`.")


def main():
    if not shutil.which("ashell"):
        sys.exit("droid: ashell not found on PATH")
    p = argparse.ArgumentParser(prog="droid", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("ui"); s.add_argument("--all", action="store_true"); s.set_defaults(f=cmd_ui)
    s = sub.add_parser("shot")
    s.add_argument("--scale", type=float, default=0.5)
    s.add_argument("--grid", action="store_true")
    s.add_argument("-o", "--output")
    s.set_defaults(f=cmd_shot)
    s = sub.add_parser("tap-id"); s.add_argument("n", type=int); s.set_defaults(f=cmd_tap_id)
    s = sub.add_parser("tap-text"); s.add_argument("text"); s.set_defaults(f=cmd_tap_text)
    s = sub.add_parser("tap"); s.add_argument("x", type=int); s.add_argument("y", type=int)
    s.set_defaults(f=lambda a: tap(a.x, a.y))
    s = sub.add_parser("longpress"); s.add_argument("x", type=int); s.add_argument("y", type=int)
    s.add_argument("ms", type=int, nargs="?", default=800)
    s.set_defaults(f=lambda a: (press(a.x, a.y, a.x, a.y, a.ms), print("long-pressed")))
    s = sub.add_parser("swipe")
    for k in ("x1", "y1", "x2", "y2"):
        s.add_argument(k, type=int)
    s.add_argument("ms", type=int, nargs="?", default=300)
    s.set_defaults(f=lambda a: (press(a.x1, a.y1, a.x2, a.y2, a.ms), print("swiped")))
    s = sub.add_parser("text"); s.add_argument("string")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--id", type=int, help="control number from `droid ui`")
    g.add_argument("--at", type=int, nargs=2, metavar=("X", "Y"))
    s.set_defaults(f=cmd_text)
    s = sub.add_parser("key"); s.add_argument("name"); s.set_defaults(f=cmd_key)
    s = sub.add_parser("app"); s.add_argument("pkg"); s.add_argument("--front", action="store_true")
    s.set_defaults(f=cmd_app)
    s = sub.add_parser("apps"); s.add_argument("filter", nargs="?"); s.set_defaults(f=cmd_apps)
    sub.add_parser("top").set_defaults(f=cmd_top)
    sub.add_parser("wake").set_defaults(f=cmd_wake)
    s = sub.add_parser("wait-text"); s.add_argument("text")
    s.add_argument("--timeout", type=float, default=10); s.set_defaults(f=cmd_wait_text)
    s = sub.add_parser("bg"); s.add_argument("action", nargs="?", choices=["stop"]); s.set_defaults(f=cmd_bg)
    sub.add_parser("show").set_defaults(f=cmd_show)

    a = p.parse_args()
    a.f(a)


if __name__ == "__main__":
    main()
