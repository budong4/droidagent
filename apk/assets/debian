#!/system/bin/sh
# debian - Android-side launcher for the Debian chroot that hosts the phone agent.
#
#   debian install <rootfs.tar.xz> <overlay-dir>   extract rootfs + apply overlay (once)
#   debian selfinstall [apk]                       unpack the rootfs carried inside the installed APK
#   debian setup [VAR=value ...]                   provision packages/Claude Code inside (slow; EXTRA=1)
#   debian start | stop | status                   mount / kill+unmount / show state
#   debian shell ['command']                       login shell (or run one command) in the chroot
#   debian app start | stop | status               the chat app (open http://127.0.0.1:8787)
#   debian appdeps                                  (re)install the chat app's npm dependency
#   debian retools                                  install the reverse-engineering toolchain
#
# Runs as root on Android (su -c). Uses KernelSU's busybox for mount/chroot.
set -u

B=/data/adb/ksu/bin/busybox
# The whole Linux system lives under the app's own device-encrypted storage, so the APK owns it:
# it goes away with the app, and it is readable before the first unlock (unlike /data/data).
APK_DIR=/data/user_de/0/com.droidagent.app
ROOT=${DEBIAN_ROOT:-$APK_DIR/rootfs}
HOME_DIR=$APK_DIR/bin
APP_HOST=${APP_HOST:-127.0.0.1}
APP_PORT=${APP_PORT:-8787}
APP_DIR=/usr/local/share/agent-app
CHROOT_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

die() { echo "debian: $*" >&2; exit 1; }
log() { echo "debian: $*"; }

[ "$(id -u)" = 0 ] || die "run as root: su -c $0 $*"
[ -x "$B" ] || die "busybox not found at $B"
SELF=$("$B" readlink -f "$0")

# Work in init's mount namespace so every su/adb shell sees the same chroot mounts.
if [ "$(readlink /proc/self/ns/mnt)" != "$(readlink /proc/1/ns/mnt)" ]; then
	exec "$B" nsenter -t 1 -m -- /system/bin/sh "$SELF" "$@"
fi

# Exact match on mountinfo: `mountpoint` compares st_dev with the parent, so it misses binds
# within one filesystem (like $ROOT bound onto itself), and every start would stack a new tree.
is_mnt() { "$B" awk -v m="$1" '$5 == m { f = 1 } END { exit !f }' /proc/self/mountinfo; }

# Mount points at or below $ROOT, one per line, from /proc/self/mountinfo field 5.
our_mounts() {
	"$B" awk -v r="$ROOT" '$5 == r || index($5, r "/") == 1 { print $5 }' /proc/self/mountinfo
}

# Android's own mounts are shared. Every bind into the chroot is made a slave right
# away, so nothing mounted or unmounted inside propagates back to the real /dev etc.
bind_in() { # bind_in <path> [rec]
	src=$1
	dst=$ROOT$1
	[ -e "$src" ] || return 0
	is_mnt "$dst" && return 0
	mkdir -p "$dst"
	if [ "${2:-}" = rec ]; then
		"$B" mount --rbind "$src" "$dst" || { log "warn: bind $src failed"; return 0; }
	else
		"$B" mount --bind "$src" "$dst" || { log "warn: bind $src failed"; return 0; }
	fi
	if ! "$B" mount --make-rslave "$dst"; then
		"$B" umount -l "$dst" 2>/dev/null
		die "could not make $dst a slave mount; refusing to continue"
	fi
}

# Android env (BOOTCLASSPATH etc.) that app_process-based tools like uiautomator need.
# Taken from our own env when it has it (adb/su/service.d all inherit init's), else zygote's.
write_android_env() {
	pat='^(ANDROID_[A-Z0-9_]+|BOOTCLASSPATH|DEX2OATBOOTCLASSPATH|SYSTEMSERVERCLASSPATH|STANDALONE_SYSTEMSERVER_JARS|EXTERNAL_STORAGE)='
	if [ -n "${BOOTCLASSPATH:-}" ]; then
		env
	else
		z=$(pidof zygote64 | "$B" awk '{print $1}')
		[ -n "$z" ] && "$B" tr '\0' '\n' < "/proc/$z/environ"
	fi | "$B" grep -E "$pat" | "$B" grep -v '^ANDROID_SOCKET_' > "$ROOT/etc/android.env.new"
	if [ -s "$ROOT/etc/android.env.new" ]; then
		mv "$ROOT/etc/android.env.new" "$ROOT/etc/android.env"
	else
		rm -f "$ROOT/etc/android.env.new"
	fi
}

mount_all() {
	[ -e "$ROOT/usr/bin/bash" ] || die "no rootfs at $ROOT (run: debian install ...)"
	if ! is_mnt "$ROOT"; then
		"$B" mount --bind "$ROOT" "$ROOT" || die "cannot bind $ROOT"
		"$B" mount --make-private "$ROOT"
		# /data is nosuid,nodev; lift that for the chroot so setuid tools behave.
		"$B" mount -o remount,bind,suid,dev "$ROOT" 2>/dev/null || true
	fi
	is_mnt "$ROOT/proc" || "$B" mount -t proc proc "$ROOT/proc"
	bind_in /dev rec
	bind_in /sys rec
	mkdir -p "$ROOT/dev/shm"
	is_mnt "$ROOT/dev/shm" || "$B" mount -t tmpfs -o mode=1777 tmpfs "$ROOT/dev/shm"
	bind_in /data
	bind_in /storage rec
	for d in /system /vendor /product /system_ext /odm /apex /linkerconfig; do
		bind_in "$d" rec
	done
	[ -L "$ROOT/sdcard" ] || ln -sfn /storage/emulated/0 "$ROOT/sdcard"
	write_android_env
}

# One busybox ls over every /proc/<pid>/root: forking readlink per process takes a minute here.
chroot_pids() {
	"$B" ls -l /proc/[0-9]*/root 2>/dev/null |
		"$B" awk -v r="$ROOT" '$NF == r { split($(NF - 2), a, "/"); print a[3] }'
}

kill_chroot() {
	pids=$(chroot_pids)
	[ -z "$pids" ] && return 0
	kill $pids 2>/dev/null
	sleep 2
	pids=$(chroot_pids)
	[ -n "$pids" ] && kill -9 $pids 2>/dev/null && sleep 1
	return 0
}

umount_all() {
	# Last line of defence against unmounting Android's own mounts through propagation.
	shared=$("$B" awk -v r="$ROOT" '($5 == r || index($5, r "/") == 1) && / shared:/ && $5 != r { print $5 }' /proc/self/mountinfo)
	[ -n "$shared" ] && die "refusing to unmount, still shared: $shared"
	# Deepest first; repeat while it makes progress, since stacked mounts share a path.
	n=$(our_mounts | "$B" wc -l)
	pass=0
	while [ "$n" -gt 0 ] && [ "$pass" -lt 10 ]; do
		our_mounts | "$B" sort -ru | while read -r m; do "$B" umount "$m" 2>/dev/null; done
		prev=$n
		n=$(our_mounts | "$B" wc -l)
		pass=$((pass + 1))
		[ "$n" -lt "$prev" ] || break
	done
	# Whatever is still busy goes with a lazy detach of the root (everything below is slave/private).
	if [ "$n" -gt 0 ]; then
		"$B" umount -l "$ROOT" 2>/dev/null
		n=$(our_mounts | "$B" wc -l)
	fi
	[ "$n" -eq 0 ] || log "warn: $n mounts still under $ROOT"
}

chroot_run() { # chroot_run <program> [args...]  (replaces this shell)
	exec "$B" chroot "$ROOT" /usr/bin/env -i -C /root \
		HOME=/root USER=root LOGNAME=root SHELL=/bin/bash LANG=C.UTF-8 \
		TERM="${TERM:-xterm-256color}" PATH="$CHROOT_PATH" "$@"
}

# Match on the command line, not comm: node renames its main thread to "MainThread".
app_pids() {
	for p in $(chroot_pids); do
		"$B" grep -qa "$APP_DIR/server/server.mjs" "/proc/$p/cmdline" 2>/dev/null && echo "$p"
	done
}

app_start() {
	mount_all
	[ -n "$(app_pids)" ] && { log "app already running"; app_status; return 0; }
	[ -f "$ROOT$APP_DIR/server/server.mjs" ] || die "app not installed at $ROOT$APP_DIR (push it from the PC)"
	[ -d "$ROOT$APP_DIR/server/node_modules" ] || die "app deps missing (run: debian appdeps)"
	mkdir -p "$ROOT/var/log"
	"$B" nohup "$B" setsid "$B" chroot "$ROOT" /usr/bin/env -i -C /root \
		HOME=/root USER=root LOGNAME=root SHELL=/bin/bash LANG=C.UTF-8 \
		TERM=dumb PATH="$CHROOT_PATH" AGENT_HOST="$APP_HOST" AGENT_PORT="$APP_PORT" \
		/usr/local/bin/node "$APP_DIR/server/server.mjs" \
		</dev/null >"$ROOT/var/log/agent-app.log" 2>&1 &
	sleep 3
	[ -n "$(app_pids)" ] || { tail -15 "$ROOT/var/log/agent-app.log"; die "app failed to start"; }
	app_status
}

app_stop() {
	pids=$(app_pids)
	[ -z "$pids" ] && { log "app not running"; return 0; }
	kill $pids
	log "app stopped"
}

app_status() {
	pids=$(app_pids)
	if [ -n "$pids" ]; then
		echo "app: running (pid $pids) at http://$APP_HOST:$APP_PORT"
	else
		echo "app: stopped"
	fi
}

# npm install for the app's one dependency (the Agent SDK). Needs network.
app_deps() {
	mount_all
	chroot_run /bin/bash -lc "cd $APP_DIR/server && npm install --omit=dev --no-audit --no-fund"
}

# Reverse-engineering / APK analysis toolchain (jadx, frida, radare2, uv, …). Slow, needs network.
retools() {
	mount_all
	chroot_run /bin/bash -l /usr/local/sbin/agent-retools
}

status() {
	if [ -e "$ROOT/usr/bin/bash" ]; then echo "rootfs: $ROOT"; else echo "rootfs: not installed"; return 0; fi
	n=$(our_mounts | "$B" wc -l)
	echo "mounts: $n"
	echo "chroot processes: $(chroot_pids | "$B" wc -l)"
	app_status
}

do_install() {
	tarball=${1:-}
	overlay=${2:-}
	[ -f "$tarball" ] || die "usage: debian install <rootfs.tar.xz> <overlay-dir>"
	[ -d "$overlay" ] || die "overlay dir not found: $overlay"
	if [ -n "$(ls -A "$ROOT" 2>/dev/null)" ]; then
		die "$ROOT is not empty; refusing to overwrite an existing rootfs"
	fi
	mkdir -p "$ROOT"
	log "extracting $tarball -> $ROOT"
	"$B" tar -xJf "$tarball" -C "$ROOT" || die "extract failed"
	log "applying overlay"
	"$B" cp -R "$overlay/." "$ROOT/" || die "overlay copy failed"
	chmod 755 "$ROOT"/usr/local/bin/* "$ROOT"/usr/local/sbin/*
	rm -f "$ROOT/etc/resolv.conf"
	printf 'nameserver 223.5.5.5\nnameserver 119.29.29.29\nnameserver 1.1.1.1\n' > "$ROOT/etc/resolv.conf"
	printf '127.0.0.1\tlocalhost droidagent\n::1\t\tlocalhost ip6-localhost ip6-loopback\n' > "$ROOT/etc/hosts"
	echo droidagent > "$ROOT/etc/hostname"
	mkdir -p "$HOME_DIR"
	[ "$SELF" = "$HOME_DIR/debian" ] || cp "$SELF" "$HOME_DIR/debian"
	chmod 755 "$HOME_DIR/debian"
	sync
	log "installed. launcher: $HOME_DIR/debian   next: debian setup"
}

# Unpack the Linux system straight out of the installed APK, so a fresh phone needs nothing
# pushed to it. Extraction goes to a scratch tree and is swapped in only once it succeeds,
# so an interrupted install can never leave a half-written rootfs behind.
do_selfinstall() {
	apk=${1:-}
	[ -f "$apk" ] || apk=$(pm path com.droidagent.app 2>/dev/null | "$B" sed 's/^package://' | head -1)
	[ -f "$apk" ] || die "cannot locate the app's APK"
	payload=$("$B" unzip -l "$apk" | "$B" awk '$NF ~ /^assets\/rootfs\.tar\./ { print $NF; exit }')
	[ -n "$payload" ] || die "this APK carries no rootfs payload"
	case $payload in
		*.tar.xz) dflag=-J ;;
		*.tar.gz) dflag=-z ;;
		*.tar) dflag= ;;
		*) die "unsupported payload format: $payload" ;;
	esac

	if [ -x "$ROOT/usr/bin/bash" ]; then
		log "rootfs already present at $ROOT; nothing to do"
		return 0
	fi

	staging="$ROOT.new"
	rm -rf "$staging"
	mkdir -p "$staging" || die "cannot create $staging"
	log "unpacking the Linux system from the app (this takes a few minutes)"
	if ! "$B" unzip -p "$apk" "$payload" | "$B" tar -x $dflag -C "$staging"; then
		rm -rf "$staging"
		die "unpack failed"
	fi
	[ -x "$staging/usr/bin/bash" ] || { rm -rf "$staging"; die "payload looks incomplete"; }

	rm -f "$staging/etc/resolv.conf"
	printf 'nameserver 223.5.5.5\nnameserver 119.29.29.29\nnameserver 1.1.1.1\n' > "$staging/etc/resolv.conf"
	printf '127.0.0.1\tlocalhost droidagent\n::1\t\tlocalhost ip6-localhost ip6-loopback\n' > "$staging/etc/hosts"
	echo droidagent > "$staging/etc/hostname"
	[ -d "$staging/usr/local/bin" ] && chmod 755 "$staging"/usr/local/bin/* 2>/dev/null
	[ -d "$staging/usr/local/sbin" ] && chmod 755 "$staging"/usr/local/sbin/* 2>/dev/null

	mv "$staging" "$ROOT" || { rm -rf "$staging"; die "could not move the new rootfs into place"; }
	mkdir -p "$HOME_DIR"
	[ "$SELF" = "$HOME_DIR/debian" ] || cp "$SELF" "$HOME_DIR/debian"
	chmod 755 "$HOME_DIR/debian"
	# This device has come back from reboots with recently-written files full of NULs
	# (size recorded, blocks never flushed), which has already destroyed this launcher once.
	sync
	log "installed at $ROOT"
}

cmd=${1:-status}
[ $# -gt 0 ] && shift
case $cmd in
install) do_install "$@" ;;
selfinstall) do_selfinstall "$@" ;;
setup)
	# chroot_run starts from an empty env, so settings like EXTRA=1 come in as arguments.
	for a in "$@"; do
		case $a in *=*) ;; *) die "usage: debian setup [VAR=value ...]  e.g. EXTRA=1" ;; esac
	done
	mount_all
	chroot_run "$@" /bin/bash -l /usr/local/sbin/agent-setup
	;;
start) mount_all && status ;;
stop)
	kill_chroot
	umount_all
	status
	;;
status) status ;;
shell)
	mount_all
	if [ $# -eq 0 ]; then chroot_run /bin/bash -l; else chroot_run /bin/bash -lc "$*"; fi
	;;
app)
	case ${1:-status} in
	start) app_start ;;
	stop) app_stop ;;
	restart) app_stop; sleep 1; app_start ;;
	status) app_status ;;
	*) die "usage: debian app start|stop|restart|status" ;;
	esac
	;;
appdeps) app_deps ;;
retools) retools ;;
*) die "unknown command '$cmd' (install|setup|start|stop|status|shell|app|appdeps|retools)" ;;
esac
